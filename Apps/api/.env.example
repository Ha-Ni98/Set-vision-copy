# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/setvision_dev
TEST_DATABASE_URL=postgresql://user:password@localhost:5433/setvision_test

# CORS
CORS_ORIGIN=http://localhost:5173

# Auth
# Must be at least 32 characters
JWT_SECRET=change_this_to_a_long_random_secret_32chars_minimum
JWT_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Logging
LOG_LEVEL=info

# Realtime (WebSocket)
WS_PATH=/socket.io

# Horizontal scaling — uncomment ONLY when running >1 instance (realtime-rules.md §9)
# REDIS_URL=redis://localhost:6379
