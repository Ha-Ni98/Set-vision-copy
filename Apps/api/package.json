{
  "name": "@my-app/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch --require dotenv/config src/server.ts",
    "build": "tsc --outDir dist",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit test/contract",
    "test:int": "NODE_ENV=test vitest run --config vitest.integration.config.ts test/integration",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "cycles": "madge --circular --extensions ts src",
    "load_wilaya": "tsx --require dotenv/config scripts/load-wilayas.ts",
    "load_commission_durations": "tsx --require dotenv/config scripts/load-commission-durations.ts",
    "create_admin_account": "tsx --require dotenv/config scripts/create-admin.ts",
    "load_mock_data": "tsx --require dotenv/config scripts/load-mock-data.ts"
  },
  "dependencies": {
    "@my-app/contract": "file:../contract",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^17.4.2",
    "madge": "^8.0.0",
    "prisma": "^6.0.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
